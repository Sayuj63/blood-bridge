# Blood Bridge messaging gateway. Copy to .env (gitignored) and fill in.

# ── Worker connection (outbound HTTPS only; no tunnel needed) ──
BLOOD_BRIDGE_URL=http://localhost:8791
# Must equal the Worker's GATEWAY_TOKEN secret (.dev.vars locally, `wrangler secret put` in prod). 24+ chars.
GATEWAY_TOKEN=change-me-to-a-long-random-string
# Shown on the dashboard and in the audit ledger. Defaults to the hostname.
# GATEWAY_ID=ops-laptop-1

# ── Channels: any of whatsapp,sms  — or `console` to test without a phone ──
CHANNELS=console
POLL_INTERVAL_MS=2000
HEARTBEAT_INTERVAL_MS=15000
# Minimum gap between two sends on the same channel (keeps WhatsApp from flagging the number).
SEND_GAP_MS=1500
LOG_LEVEL=info

# ── Console adapter (CHANNELS=console) ──
# Which channel the console pretends to be, and the default "phone number" for typed lines.
CONSOLE_CHANNEL=whatsapp
CONSOLE_FROM=+919800000001

# ── WhatsApp via open-wa (unofficial: use a SPARE number) ──
WA_SESSION_ID=blood-bridge
# Session (= a logged-in credential) is kept here; gitignored.
WA_SESSION_DIR=.session
WA_HEADLESS=true
# Answer blood requests posted in WhatsApp groups the number is in (on|off).
WA_GROUPS=on
# Optional: use an installed Chrome instead of the bundled browser.
# WA_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ── SMS via SMS Gateway for Android (https://sms-gate.app) ──
# cloud: the app's Cloud server (credentials shown in the app under "Cloud server").
# local: the app's Local server on your LAN (credentials under "Local server").
SMS_MODE=cloud
SMS_USERNAME=
SMS_PASSWORD=
# Local mode only: the phone's address as shown in the app, e.g. http://192.168.1.20:8080
# SMS_LOCAL_URL=
# SMS_CLOUD_URL=https://api.sms-gate.app/3rdparty/v1
# Optional: which SIM sends (1 or 2).
# SMS_SIM_NUMBER=1
# Inbound SMS arrive as webhooks from the phone/cloud. 0 disables the listener.
SMS_WEBHOOK_PORT=3977
# If set, the gateway registers this URL for `sms:received` on start.
# Local mode: http://<this-laptop-LAN-ip>:3977/sms/webhook   Cloud mode: needs a public URL.
# SMS_WEBHOOK_PUBLIC_URL=
# Signing key from the app's webhook settings; when set, unsigned webhooks are rejected.
# SMS_WEBHOOK_SIGNING_KEY=
