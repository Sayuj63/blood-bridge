# Copy to .dev.vars for local secrets. Everything here is OPTIONAL — `pnpm dev` works without it
# (local SQLite database, AI falls back to templates).

# Use the hosted Turso database instead of the local one (ask the team for values):
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# MCP server write tools (ChatGPT / Claude connector):
# MCP_TOKEN=

# Laptop WhatsApp gateway ↔ Worker shared secret (24+ chars, same value as gateway/.env):
# GATEWAY_TOKEN=
